# GMP-MERP configuration. Copy to .env. NEVER commit real values.
MERP_ENVIRONMENT=development            # development | test | production
MERP_DATABASE_URL=mssql+pyodbc://merp_app:CHANGE_ME@DBHOST/MERP?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=no
# MERP_DATABASE_URL=sqlite:///./merp_dev.db   # dev only
MERP_MIGRATION_DATABASE_URL=            # merp_migrator account (DDL); used by Alembic only
MERP_SECRET_KEY=CHANGE_ME_LONG_RANDOM
MERP_AUDIT_HMAC_KEY=CHANGE_ME_LONG_RANDOM_DIFFERENT   # keys the audit hash chain; rotate per SOP
MERP_COOKIE_SECURE=true
MERP_SESSION_IDLE_MINUTES=15
MERP_SESSION_ABSOLUTE_HOURS=8
MERP_MAX_CONCURRENT_SESSIONS=0          # 0 = unlimited
MERP_PASSWORD_MIN_LENGTH=12
MERP_PASSWORD_HISTORY=12
MERP_PASSWORD_MAX_AGE_DAYS=90
MERP_LOCKOUT_THRESHOLD=5
MERP_LOCKOUT_MINUTES=15
# Active Directory / LDAP
MERP_LDAP_ENABLED=false
MERP_LDAP_SERVER_URI=ldaps://dc01.example.local:636
MERP_LDAP_BIND_FORMAT={username}@example.local      # or uid={username},ou=people,dc=example,dc=local
# Email
MERP_SMTP_HOST=
MERP_SMTP_PORT=587
MERP_SMTP_USER=
MERP_SMTP_PASSWORD=
MERP_SMTP_FROM=
# Storage / site
MERP_FILE_STORAGE_PATH=./storage/documents
MERP_LOG_DIR=./logs
MERP_SITE_TIMEZONE=Asia/Kolkata
MERP_APP_NAME=GMP-MERP
# First-run admin bootstrap (scripts/bootstrap_admin.py) - used once, then remove
MERP_BOOTSTRAP_ADMIN_USERNAME=
MERP_BOOTSTRAP_ADMIN_PASSWORD=
